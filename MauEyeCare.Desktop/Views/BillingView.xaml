<UserControl x:Class="MauEyeCare.Desktop.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Patient selector -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="Search Patients" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,12" Height="36" VerticalContentAlignment="Center"
                         Text="{Binding PatientSearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Select Patient" Style="{StaticResource HeadingH2}" Margin="0,0,0,12" />
                <ComboBox Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient}"
                          DisplayMemberPath="FullName" Margin="0,0,0,24" />

                <!-- Optical Shop Integration -->
                <TextBlock Text="Optical Shop POS" Style="{StaticResource HeadingH2}" Margin="0,0,0,12" />
                <TextBlock Text="DESCRIPTION" Style="{StaticResource FormLabel}" />
                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,12" Height="36" 
                         Text="{Binding ShopDescription, UpdateSourceTrigger=PropertyChanged}" />
                
                <TextBlock Text="AMOUNT (₹)" Style="{StaticResource FormLabel}" />
                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,20" Height="36"
                         Text="{Binding ShopAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                <Button Style="{StaticResource PrimaryButton}" Content="Generate Invoice" 
                        Command="{Binding CreateShopInvoiceCommand}" Height="40" />
            </StackPanel>
        </Border>
        <!-- Invoice list -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Invoice History" Style="{StaticResource HeadingH2}" Margin="0,0,0,16" />
                <DataGrid Style="{StaticResource DarkDataGrid}"
                          ItemsSource="{Binding Invoices}"
                          ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Width="120" Binding="{Binding Date}" />
                        <DataGridTextColumn Header="Total (₹)" Width="*" Binding="{Binding Total, StringFormat=N2}" />
                        <DataGridTextColumn Header="Paid (₹)" Width="*" Binding="{Binding Paid, StringFormat=N2}" />
                        <DataGridTextColumn Header="Status" Width="100" Binding="{Binding Status}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
