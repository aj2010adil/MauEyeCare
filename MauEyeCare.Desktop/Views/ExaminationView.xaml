<UserControl x:Class="MauEyeCare.Desktop.Views.ExaminationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ PATIENT SELECTOR ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Patient:" Style="{StaticResource BodyText}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Style="{StaticResource DarkComboBox}" MinWidth="280"
                          ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient}"
                          DisplayMemberPath="FullName" />
                <TextBlock Text="{Binding SelectedPatient.Phone}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Start Exam"
                        Command="{Binding StartExamCommand}" Margin="24,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ══ LEFT: Refraction & Clinical Data ═══════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}"
                Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Patient Clinical Background" Style="{StaticResource HeadingH2}"
                               Margin="0,0,0,16" />

                    <!-- Complaints & History -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CHIEF COMPLAINTS" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource DarkComboBox}" Height="36"
                                      ItemsSource="{Binding ComplaintValues}"
                                      Text="{Binding Exam.Complaints, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MEDICAL HISTORY" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource DarkComboBox}" Height="36"
                                      ItemsSource="{Binding MedicalHistoryValues}"
                                      Text="{Binding Exam.MedicalHistory, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Refraction Details" Style="{StaticResource HeadingH2}"
                               Margin="0,0,0,16" />

                    <!-- Refraction Table Header -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Eye" Style="{StaticResource FormLabel}" />
                        <TextBlock Grid.Column="1" Text="SPH" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="CYL" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="AXIS" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="VA" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="IOP" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" />
                    </Grid>

                    <!-- OD Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="4"
                                Padding="4,6">
                            <TextBlock Text="OD (R)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TealAccentBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.SphereValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OD_Sphere, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="2" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.CylinderValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OD_Cylinder, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="3" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.AxisValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OD_Axis, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="4" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.VaValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OD_VA, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="5" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.IopValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OD_IOP, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                    </Grid>

                    <!-- OS Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="4" Padding="4,6">
                            <TextBlock Text="OS (L)" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TealAccentBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.SphereValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OS_Sphere, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="2" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.CylinderValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OS_Cylinder, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="3" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.AxisValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OS_Axis, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="4" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.VaValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OS_VA, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="5" Style="{StaticResource DarkComboBox}" Margin="4,0" Height="36"
                                  ItemsSource="{Binding DataContext.IopValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Exam.WG_OS_IOP, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalContentAlignment="Center" />
                    </Grid>

                    <!-- Add power row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="OD ADD POWER" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource DarkComboBox}" Height="36"
                                      ItemsSource="{Binding AddValues}"
                                      Text="{Binding Exam.WG_OD_Add, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OS ADD POWER" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource DarkComboBox}" Height="36"
                                      ItemsSource="{Binding AddValues}"
                                      Text="{Binding Exam.WG_OS_Add, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                        </StackPanel>
                    </Grid>

                    <!-- Diagnosis -->
                    <TextBlock Text="DIAGNOSIS" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Height="80"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"
                             Text="{Binding Exam.Diagnosis, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- BP & Standard Checkups -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BLOOD PRESSURE (BP)" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Height="36"
                                     Text="{Binding Exam.BloodPressure, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BLOOD SUGAR" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Height="36"
                                     Text="{Binding Exam.BloodSugar, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Medicine & Frames Prescriptions -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SELECT MEDICINE FROM INVENTORY" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{Binding AvailableMedicines}"
                                      SelectedItem="{Binding SelectedInventoryMedicine}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                      Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" Height="42" />
                            <TextBlock Text="MEDICINES (Prescribed / External)" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Height="36"
                                     Text="{Binding Exam.MedicinesPrescribed, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SELECT FRAME FROM INVENTORY" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{Binding AvailableFrames}"
                                      SelectedItem="{Binding SelectedInventoryFrame}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                      Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" Height="42" />
                            <TextBlock Text="FRAMES / LENSES (Prescribed / External)" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Height="36"
                                     Text="{Binding Exam.FramesPrescribed, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Doctor Notes -->
                    <TextBlock Text="DOCTOR'S NOTES" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Height="100"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"
                             Text="{Binding Exam.DoctorNotes, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- OCR Note Upload -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,20"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📝  OCR — Handwritten Note" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource TealAccentBrush}"
                                       Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Upload Note Image"
                                        Command="{Binding UploadNoteCommand}" Padding="12,8" />
                                <TextBlock Text="{Binding OcrStatus}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Style="{StaticResource DarkTextBox}" Height="60"
                                     TextWrapping="Wrap" Margin="0,8,0,0" IsReadOnly="True"
                                     Text="{Binding OcrExtractedText}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Apply OCR to Notes"
                                    Command="{Binding ApplyOcrCommand}" Padding="12,8"
                                    HorizontalAlignment="Right" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- AI Prescriptive Ranges -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,24"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="💡 AI Prescription Support" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="Captures manual refraction parameters &amp; autorefractor values to guide clinician thresholds." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,16" />

                            <Button Style="{StaticResource PrimaryButton}" Content="GENERATE AI RANGES" Command="{Binding GetRxSuggestionCommand}" Margin="0,0,0,16" />

                            <Border Background="{DynamicResource SurfaceBrush}" Padding="12" CornerRadius="6" Visibility="{Binding HasRxSuggestion, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AiRxSuggestion}" Foreground="#00BFA5" TextWrapping="Wrap" FontSize="13" />
                                    <TextBlock Text="* CLINICIAN OVERRIDE REQUIRED — System parameters do not replace licensed diagnosis." Foreground="#E57373" FontSize="10" Margin="0,12,0,0" FontStyle="Italic" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Save Exam"
                                Command="{Binding SaveExamCommand}" Height="44" MinWidth="120" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Generate PDF Rx" Margin="12,0,0,0"
                                Background="#2A3F55"
                                Command="{Binding GeneratePdfCommand}" Height="44" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ RIGHT: Image Upload + AI Analysis ══════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="🧠  AI Image Analysis" Style="{StaticResource HeadingH2}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Decision Support Only" FontSize="10"
                           Foreground="{StaticResource TealAccentBrush}" Margin="0,0,0,16" />

                <!-- AI Disclaimer -->
                <Border Style="{StaticResource AIDisclaimerBanner}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚠  AI Decision Support" FontSize="11"
                                   FontWeight="SemiBold" Foreground="#FFB300" />
                        <TextBlock TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                                   Foreground="#CC9900">
                            AI outputs require clinician review before any clinical action.
                            Confidence scores indicate model certainty, not clinical certainty.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Image upload area -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Height="160"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,1"
                        AllowDrop="True" Margin="0,0,0,12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📷" FontSize="36" HorizontalAlignment="Center" />
                        <TextBlock Text="Drag &amp; drop fundus / OCT image"
                                   Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Browse File"
                                Command="{Binding BrowseImageCommand}"
                                HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,8" />
                    </StackPanel>
                </Border>

                <!-- Image type selector -->
                <TextBlock Text="IMAGE TYPE" Style="{StaticResource FormLabel}" />
                <ComboBox Style="{StaticResource DarkComboBox}" Margin="0,0,0,12"
                          SelectedItem="{Binding SelectedImageType}">
                    <ComboBoxItem Content="Fundus" />
                    <ComboBoxItem Content="OCT" />
                    <ComboBoxItem Content="Slit Lamp" />
                    <ComboBoxItem Content="Retinal Photo" />
                </ComboBox>

                <!-- Consent checkbox -->
                <CheckBox Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                          Margin="0,0,0,12"
                          IsChecked="{Binding ConsentGiven}"
                          Content="Patient has given consent for AI analysis" />

                <!-- Analyze button -->
                <Button Style="{StaticResource PrimaryButton}" Content="Analyze with AI"
                        Command="{Binding AnalyzeImageCommand}" Height="44"
                        IsEnabled="{Binding ConsentGiven}" />

                <!-- Results -->
                <Border Margin="0,16,0,0"
                        Visibility="{Binding HasAiResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Analysis Results" FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding AiSuggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,8"
                                            Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Condition}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right"
                                                    Background="{StaticResource TealAccentBrush}"
                                                    CornerRadius="8" Padding="8,3">
                                                <TextBlock Text="{Binding ConfidenceDisplay}"
                                                           Foreground="White" FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AiQualityScore}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,8,0,0" />

                        <!-- AI Feedback -->
                        <TextBlock Text="CORRECT LABEL / DIAGNOSIS (If AI was wrong)" Style="{StaticResource FormLabel}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource DarkTextBox}" Height="32" 
                                 Text="{Binding CorrectAiLabel, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Submit Correction to ML Pipeline"
                                Command="{Binding SubmitAiCorrectionCommand}" Height="32" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding FeedbackStatus}" Foreground="{StaticResource TealAccentBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
