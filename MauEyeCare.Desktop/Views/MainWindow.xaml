<Window x:Class="MauEyeCare.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MauEyeCare.Desktop.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MauEyeCare — Optometry Clinic"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Border CornerRadius="12" ClipToBounds="True"
            Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />      <!-- Sidebar -->
                <ColumnDefinition Width="*" />         <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- ══ SIDEBAR ════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Brand header -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,8"
                                MouseDown="TitleBar_MouseDown">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="36" Height="36">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00BFA5" Offset="0" />
                                        <GradientStop Color="#1A2340" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="👁" FontSize="20" Margin="-30,0,0,0"
                                       VerticalAlignment="Center" />
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="MauEyeCare"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                 <TextBlock Text="v1.2.0  •  Clinic Suite"
                                            FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource BorderBrush}" Margin="16,0" />

                    <!-- Navigation items -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                                  Margin="0,12,0,0">
                        <StackPanel>
                            <!-- Section: Main -->
                            <TextBlock Text="MAIN" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,8,0,4" />

                            <Button x:Name="NavDashboard" Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                    Tag="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" FontSize="16" Width="24" />
                                    <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Patients">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="16" Width="24" />
                                    <TextBlock Text="Patients" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Appointments">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" FontSize="16" Width="24" />
                                    <TextBlock Text="Appointments" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Section: Clinical -->
                            <TextBlock Text="CLINICAL" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,16,0,4" />

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Examination">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔬" FontSize="16" Width="24" />
                                    <TextBlock Text="Examination" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Prescription">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💊" FontSize="16" Width="24" />
                                    <TextBlock Text="Prescriptions" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="AI">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧠" FontSize="16" Width="24" />
                                    <StackPanel>
                                        <TextBlock Text="AI Analysis" Margin="10,0,0,0" />
                                        <TextBlock Text="Decision Support" FontSize="9"
                                                   Foreground="#00BFA5" Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Section: Admin -->
                            <TextBlock Text="ADMINISTRATION" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,16,0,4" />

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Billing">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="16" Width="24" />
                                    <TextBlock Text="Billing" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Inventory">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="16" Width="24" />
                                    <TextBlock Text="Inventory" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Reports">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="16" Width="24" />
                                    <TextBlock Text="Reports" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="16" Width="24" />
                                    <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="ReleaseNotes"
                                    Margin="0,20,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📜" FontSize="16" Width="24" />
                                    <TextBlock Text="What's New?" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryHueMidBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom: User info + logout -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="16,12" Background="{DynamicResource InputBackgroundBrush}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Ellipse Width="32" Height="32" DockPanel.Dock="Left">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="https://ui-avatars.com/api/?name=Admin&amp;background=00BFA5&amp;color=fff" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CurrentUserRole}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button Content="Log Out" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                        Command="{Binding LogoutCommand}" Cursor="Hand" />
                            </DockPanel>
                            <Button Content="EXIT APPLICATION" Background="#E57373" Foreground="White" 
                                    FontWeight="Bold" FontSize="10" Padding="12,8" BorderThickness="0"
                                    Cursor="Hand" Click="CloseButton_Click" HorizontalAlignment="Stretch">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ══ CONTENT AREA ═══════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- Top bar -->
                    <RowDefinition Height="*" />       <!-- Page content -->
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="24,12" MouseDown="TitleBar_MouseDown" Height="64">
                    <Grid>
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   Style="{StaticResource HeadingH2}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Search bar -->
                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="18" Padding="12,6" MinWidth="220"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,24,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                             Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" MinWidth="160" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Notification -->
                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,24,0">
                                <Grid>
                                    <TextBlock Text="🔔" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Ellipse Width="8" Height="8" Fill="#FF5252" HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}" Margin="0,-2,0,0" />
                                </Grid>
                            </Button>

                            <!-- Divider -->
                            <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}" Margin="0,0,24,0" />

                            <!-- Window controls -->
                            <Button Content="—" Width="32" Height="32" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="MinimizeButton_Click" />
                            <Button Content="✕" Width="32" Height="32" FontSize="14" Foreground="#E57373"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                    Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content Frame -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentView}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Margin="24" />
            </Grid>
        </Grid>
    </Border>

</Window>
