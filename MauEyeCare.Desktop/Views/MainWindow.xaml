<Window x:Class="MauEyeCare.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MauEyeCare.Desktop.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MauEyeCare — Optometry Clinic"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Border CornerRadius="12" ClipToBounds="True"
            Background="{StaticResource DarkSurfaceBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />      <!-- Sidebar -->
                <ColumnDefinition Width="*" />         <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- ══ SIDEBAR ════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="{StaticResource SidebarGradient}"
                    BorderBrush="#1E3048" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Brand header -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,8"
                                MouseDown="TitleBar_MouseDown">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="36" Height="36">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00BFA5" Offset="0" />
                                        <GradientStop Color="#1A2340" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="👁" FontSize="20" Margin="-30,0,0,0"
                                       VerticalAlignment="Center" />
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="MauEyeCare"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="v1.0  •  Clinic Suite"
                                           FontSize="9" Foreground="#4A6075" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,0,12,16">
                        <Button Content="—" Width="24" Height="24" FontSize="12"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#4A6075" Cursor="Hand"
                                Click="MinimizeButton_Click" />
                        <Button Content="✕" Width="24" Height="24" FontSize="12"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#4A6075" Cursor="Hand"
                                Click="CloseButton_Click" />
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="#1E3048" Margin="16,0" />

                    <!-- Navigation items -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                                  Margin="0,12,0,0">
                        <StackPanel>
                            <!-- Section: Main -->
                            <TextBlock Text="MAIN" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#4A6075" Margin="24,8,0,4" />

                            <Button x:Name="NavDashboard" Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                    Tag="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" FontSize="16" Width="24" />
                                    <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Patients">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="16" Width="24" />
                                    <TextBlock Text="Patients" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Appointments">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" FontSize="16" Width="24" />
                                    <TextBlock Text="Appointments" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Section: Clinical -->
                            <TextBlock Text="CLINICAL" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#4A6075" Margin="24,16,0,4" />

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Examination">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔬" FontSize="16" Width="24" />
                                    <TextBlock Text="Examination" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Prescription">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💊" FontSize="16" Width="24" />
                                    <TextBlock Text="Prescriptions" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="AI">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧠" FontSize="16" Width="24" />
                                    <StackPanel>
                                        <TextBlock Text="AI Analysis" Margin="10,0,0,0" />
                                        <TextBlock Text="Decision Support" FontSize="9"
                                                   Foreground="#00BFA5" Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Section: Admin -->
                            <TextBlock Text="ADMINISTRATION" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#4A6075" Margin="24,16,0,4" />

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Billing">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="16" Width="24" />
                                    <TextBlock Text="Billing" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Inventory">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="16" Width="24" />
                                    <TextBlock Text="Inventory" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Reports">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="16" Width="24" />
                                    <TextBlock Text="Reports" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="16" Width="24" />
                                    <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom: User info + logout -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="#1E3048"
                            BorderThickness="0,1,0,0" Padding="16,12">
                        <DockPanel>
                            <Ellipse Width="36" Height="36" DockPanel.Dock="Left">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#00BFA5" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserName}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding CurrentUserRole}"
                                           FontSize="10" Foreground="{StaticResource TealAccentBrush}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="⏻"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#4A6075" FontSize="16"
                                    Cursor="Hand" Command="{Binding LogoutCommand}"
                                    HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ══ CONTENT AREA ═══════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- Top bar -->
                    <RowDefinition Height="*" />       <!-- Page content -->
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="{StaticResource DarkSurfaceBrush}"
                        BorderBrush="#1E3048" BorderThickness="0,0,0,1"
                        Padding="24,12">
                    <DockPanel>
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   Style="{StaticResource HeadingH2}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" />

                        <!-- Search bar -->
                        <Border DockPanel.Dock="Right" Background="#0F1824"
                                CornerRadius="20" Padding="12,8" MinWidth="260"
                                BorderBrush="#2A3F55" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="13" Foreground="#4A6075"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" MinWidth="200" VerticalAlignment="Center"
                                         CaretBrush="{StaticResource TealAccentBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Notification bell -->
                        <Button DockPanel.Dock="Right" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="🔔" FontSize="18" />
                                <Ellipse Width="8" Height="8" Fill="#FF5252"
                                         HorizontalAlignment="Right" Margin="0,-8,0,0"
                                         Visibility="{Binding HasAlerts,
                                             Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Page Content Frame -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentView}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Margin="24" />
            </Grid>
        </Grid>
    </Border>

</Window>
