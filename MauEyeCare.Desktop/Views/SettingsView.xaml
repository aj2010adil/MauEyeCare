<UserControl x:Class="MauEyeCare.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙  System Settings" Style="{StaticResource HeadingH1}" Margin="0,0,0,24" />

        <!-- Theme Toggle -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="400">
                    <TextBlock Text="Visual Appearance" Style="{StaticResource HeadingH2}" Margin="0,0,0,8" />
                    <TextBlock Text="Choose between Light and Dark interface themes for optimal visibility." 
                               Style="{StaticResource CaptionText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="40,0,0,0">
                    <TextBlock Text="Light" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource BodyText}" />
                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding IsDarkMode}" />
                    <TextBlock Text="Dark" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource BodyText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Ollama Configuration -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="400">
                    <TextBlock Text="Local GenAI (Ollama)" Style="{StaticResource HeadingH2}" Margin="0,0,0,8" />
                    <TextBlock Text="Enable local AI support for doctor assistance (requires Ollama running on port 11434)." 
                               Style="{StaticResource CaptionText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="40,0,0,0">
                    <CheckBox IsChecked="{Binding UseOllama}" Content="Use Local Ollama" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <StackPanel Width="150">
                        <TextBlock Text="MODEL" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding OllamaModel}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Change Password -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Change Password" Style="{StaticResource HeadingH2}" Margin="0,0,0,16" />
                    
                    <TextBlock Text="NEW PASSWORD" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" Height="42"
                             Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" Height="42"
                             Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding PasswordStatus}" Margin="0,0,0,12" FontSize="12"
                               Foreground="{StaticResource TealAccentBrush}"
                               Visibility="{Binding HasPasswordError, Converter={StaticResource InverseBoolToVis}}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="Update Password" 
                            Command="{Binding ChangePasswordCommand}" Height="44" />
                </StackPanel>
            </Border>

            <!-- Add New Roles -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Role Management" Style="{StaticResource HeadingH2}" Margin="0,0,0,16" />
                    
                    <TextBlock Text="ROLE NAME" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" Height="42"
                             Text="{Binding NewRoleName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding RoleStatus}" Margin="0,0,0,12" FontSize="12"
                               Foreground="{StaticResource TealAccentBrush}"
                               Visibility="{Binding HasRoleError, Converter={StaticResource InverseBoolToVis}}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="Create New Role" 
                            Command="{Binding CreateRoleCommand}" Height="44" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20" Margin="0,24,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Software Update" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
                    <TextBlock Text="Keep MauEyeCare up to date for the latest clinical analytics and stability fixes." Foreground="#8BA0B5" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Current Version: 2.1.0" Foreground="White" FontWeight="SemiBold" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding UpdateStatus}" Foreground="#00BFA5" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" 
                        Content="CHECK FOR UPDATES" 
                        Command="{Binding CheckUpdatesCommand}"
                        Width="220" Height="44" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
