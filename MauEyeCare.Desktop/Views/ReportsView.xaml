<UserControl x:Class="MauEyeCare.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <TextBlock Text="Analytics &amp; Performance Reports" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Comprehensive insights into clinic operations and patient demographics." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,32" />

                <UniformGrid Columns="4" Margin="0,0,0,24">
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,0,16,16" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL REVENUE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TotalRevenue}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8" />
                            <TextBlock Text="{Binding GrowthRate}" FontSize="11" Foreground="#00BFA5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,0,16,16" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SHOP REVENUE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ShopRevenue}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TealAccentBrush}" HorizontalAlignment="Center" Margin="0,8" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Download Excel" 
                                    Command="{Binding ExportShopRevenueCommand}" FontSize="10" Padding="8,2" />
                            <TextBlock Text="Ready for disbursement" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,0,16,16" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CLINICAL REVENUE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ClinicalRevenue}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Download Excel" 
                                    Command="{Binding ExportClinicalRevenueCommand}" FontSize="10" Padding="8,2" />
                            <TextBlock Text="Excl. tax" FontSize="11" Foreground="#00BFA5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,0,0,16" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="RECALLS ISSUED" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="4" FontSize="36" FontWeight="Bold" Foreground="#FF8A80" HorizontalAlignment="Center" Margin="0,8" />
                            <TextBlock Text="Require immediate review" FontSize="11" Foreground="#FF8A80" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Predictive Recall Notifications" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="AI-driven suggestions for automated lens updates &amp; critical patient reviews." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,16" />
                        
                        <DataGrid Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" AutoGenerateColumns="False" IsReadOnly="True"
                                  ItemsSource="{Binding Recalls}" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Patient" Width="2*" Binding="{Binding PatientName}" />
                                <DataGridTextColumn Header="Recall Reason" Width="3*" Binding="{Binding Reason}" />
                                <DataGridTextColumn Header="Target Date" Width="1.5*" Binding="{Binding DueDate}" />
                                <DataGridTextColumn Header="Urgency Level" Width="1.5*" Binding="{Binding Urgency}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
