<UserControl x:Class="MauEyeCare.Desktop.Views.AiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AI Clinical Decision Support" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <Border Margin="24,0,0,8" Padding="12,4" CornerRadius="12" VerticalAlignment="Center"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding AiServiceStatus}" FontSize="12" Foreground="{DynamicResource TealAccentBrush}" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Advanced triage and diagnostic assistance powered by deep learning." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,32" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Upload and Preview -->
                    <StackPanel Grid.Column="0" Margin="0,0,32,0">
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="40" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CloudUpload" Width="64" Height="64" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
                                <TextBlock Text="Upload Retinal Fundus or OCT Image" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" Margin="0,0,0,8" />
                                <TextBlock Text="Supported formats: JPG, PNG, DICOM" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,24" />
                                
                                <Button Content="SELECT IMAGE" Style="{StaticResource PrimaryButton}" Width="200" 
                                        Command="{Binding BrowseImageCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,24,0,0" Padding="12" MinHeight="300">
                            <Grid>
                                <Image Source="{Binding SelectedImageSource}" Stretch="Uniform" MaxHeight="500" />
                                <TextBlock Text="No image selected" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right: Analysis Results -->
                    <StackPanel Grid.Column="1">
                        <Button Content="RUN AI ANALYSIS" Style="{StaticResource PrimaryButton}" Height="50" 
                                Command="{Binding AnalyzeCommand}" IsEnabled="{Binding HasImage}" />
                        
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0" 
                                     Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" 
                                     Foreground="{StaticResource TealAccentBrush}" Background="Transparent" />

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,24,0,0" Padding="24"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="ANALYSIS RESULTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
                                
                                <ItemsControl ItemsSource="{Binding Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12" Background="{DynamicResource SurfaceBrush}" Padding="16" CornerRadius="8">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Condition}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ConfidencePercent}" Foreground="{DynamicResource TealAccentBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar Value="{Binding Confidence}" Maximum="1" Height="4" Margin="0,8,0,0" 
                                                                 Foreground="{StaticResource TealAccentBrush}" Background="{DynamicResource CardBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="INCORRECT PREDICTION? PROVIDE FEEDBACK" FontSize="12" FontWeight="Bold" Foreground="#FF8A80" Margin="0,0,0,8" />
                                        
                                        <ComboBox ItemsSource="{Binding ConditionLabels}" 
                                                  SelectedItem="{Binding CorrectLabelSelection, Mode=TwoWay}"
                                                  materialDesign:HintAssist.Hint="Select correct diagnosis"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                                  
                                        <Button Content="SUBMIT FEEDBACK &amp; IMPROVE" 
                                                Command="{Binding SubmitFeedbackCommand}"
                                                Background="#FF5252" BorderBrush="#FF5252" Foreground="White" />
                                                
                                        <TextBlock Text="{Binding FeedbackStatus}" Foreground="#00BFA5" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BorderBrush}" Padding="12" CornerRadius="6" Margin="0,16,0,0">
                                    <TextBlock Text="{Binding Disclaimer}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" FontStyle="Italic" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
