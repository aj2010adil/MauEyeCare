<UserControl x:Class="MauEyeCare.Desktop.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/> <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Patient Registry" Style="{StaticResource HeadingH2}"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Import Excel" 
                                Command="{Binding ImportPatientsCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Export Excel" 
                                Command="{Binding ExportPatientsCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="+ New Patient" Command="{Binding NewPatientCommand}" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" MinWidth="300" VerticalAlignment="Center"
                                 CaretBrush="{StaticResource TealAccentBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="◀" Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Command="{Binding PrevPageCommand}" />
                    <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0" />
                    <Button Content="▶" Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Command="{Binding NextPageCommand}" />
                </StackPanel>

                <DataGrid Style="{StaticResource DarkDataGrid}"
                          ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient}"
                          ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                          AutoGenerateColumns="False"
                          MinHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Width="*"
                            Binding="{Binding FullName}" />
                        <DataGridTextColumn Header="Phone" Width="100"
                            Binding="{Binding Phone}" />
                        <DataGridTextColumn Header="DOB" Width="80"
                            Binding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" />
                        <DataGridTextColumn Header="Gender" Width="80"
                            Binding="{Binding Gender}" />
                        
                        <DataGridTemplateColumn Header="Actions" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✏" ToolTip="Edit"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Foreground="{StaticResource TealAccentBrush}"
                                                Command="{Binding DataContext.EditPatientRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        
                                        <Button Content="🔬" ToolTip="New Exam"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Foreground="#8BA0B5" Margin="10,0"
                                                Command="{Binding DataContext.NewExamCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                                
                                        <Button Content="🗑" ToolTip="Delete"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Foreground="#FF453A"
                                                Command="{Binding DataContext.DeletePatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource HeadingH2}"
                               Margin="0,0,0,20" />

                    <TextBlock Text="FIRST NAME *" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" Height="42"
                             Text="{Binding EditPatient.FirstName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="LAST NAME *" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" Height="42"
                             Text="{Binding EditPatient.LastName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="AGE *" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Height="42" FontSize="13"
                                     Text="{Binding EditPatient.Age, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GENDER" Style="{StaticResource FormLabel}" />
                            
                            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Select Gender"
                                      SelectedValue="{Binding EditPatient.Gender, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Background="{DynamicResource SurfaceBrush}">
                                <ComboBoxItem Content="Male" />
                                <ComboBoxItem Content="Female" />
                                <ComboBoxItem Content="Other" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="PHONE NUMBER" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" Height="42"
                             Text="{Binding EditPatient.Phone, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" Height="42"
                             Text="{Binding EditPatient.Email, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="ADDRESS" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"
                             Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding EditPatient.Address, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="MEDICAL HISTORY" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding EditPatient.MedicalHistory, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="ALLERGIES" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" Height="42"
                             Text="{Binding EditPatient.Allergies, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Explicit Consent for AI Image Analysis"
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"
                              IsChecked="{Binding EditPatient.HasAiConsent, Mode=TwoWay}" />

                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                        <TextBlock Text="REFERRAL LETTER TEXT (OCR)" Style="{StaticResource FormLabel}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Scan Document"
                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                Command="{Binding ScanReferralLetterCommand}" />
                    </DockPanel>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,20"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding EditPatient.ReferralLetterText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding FormError}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding HasFormError, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Save Patient"
                                Command="{Binding SavePatientCommand}" Height="44" MinWidth="130" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Clear"
                                Command="{Binding ClearFormCommand}" Height="44"
                                Margin="12,0,0,0" MinWidth="80" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,10"
                            Margin="0,12,0,0"
                            Visibility="{Binding SaveSuccess, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✔  Patient record saved successfully."
                                   Foreground="{StaticResource SuccessBrush}" FontSize="12" />
                    </Border>

                    <!-- Patient History DataGrid -->
                    <TextBlock Text="PATIENT EXAM HISTORY" Style="{StaticResource HeadingH2}" Margin="0,30,0,10" />
                    <DataGrid Style="{StaticResource DarkDataGrid}"
                              ItemsSource="{Binding SelectedPatientExams}"
                              AutoGenerateColumns="False"
                              MinHeight="150"
                              MaxHeight="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Width="100" Binding="{Binding Date}" />
                            <DataGridTextColumn Header="Diagnosis" Width="*" Binding="{Binding Condition}" />
                            <DataGridTextColumn Header="Doctor Notes" Width="*" Binding="{Binding Summary}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>