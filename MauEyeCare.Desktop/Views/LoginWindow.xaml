<Window x:Class="MauEyeCare.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MauEyeCare — Login"
        Width="420" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">


    <Border CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.7" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Drag handle -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Drag bar -->
            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Height="32"
                    MouseDown="DragBar_MouseDown">
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="32" Height="32"
                        Background="#D32F2F" BorderThickness="0"
                        Foreground="White" FontSize="14" FontWeight="Bold"
                        Click="CloseButton_Click" Content="✕"
                        Cursor="Hand" />
            </Border>

            <!-- Login content -->
            <StackPanel Grid.Row="1" Margin="40,20,40,20" VerticalAlignment="Center">

                <!-- Logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Ellipse Width="72" Height="72" HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00BFA5" Offset="0" />
                                <GradientStop Color="#1A2340" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="👁" FontSize="36" HorizontalAlignment="Center"
                               Margin="0,-56,0,0" />
                    <TextBlock Text="MauEyeCare" HorizontalAlignment="Center"
                               FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Optometry Clinic Management" HorizontalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Role Selector -->
                <TextBlock Text="CHOOSE ROLE FOR TESTING" Style="{StaticResource FormLabel}" />
                <ComboBox x:Name="RoleSelector" Style="{StaticResource DarkComboBox}"
                          Margin="0,0,0,16" Height="42"
                          SelectionChanged="RoleSelector_SelectionChanged">
                    <ComboBoxItem Content="Admin / Director" Tag="admin@maueyecare.com|Admin@12345" />
                    <ComboBoxItem Content="Doctor / Optometrist" Tag="admin@maueyecare.com|Admin@12345" />
                    <ComboBoxItem Content="Receptionist" Tag="admin@maueyecare.com|Admin@12345" />
                    <ComboBoxItem Content="Technician" Tag="admin@maueyecare.com|Admin@12345" />
                </ComboBox>

                <!-- Email -->
                <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource FormLabel}" />
                <TextBox x:Name="EmailBox" Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,16" Height="42"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Password -->
                <TextBlock Text="PASSWORD" Style="{StaticResource FormLabel}" />
                <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,0,0,24"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Padding="10,8" FontSize="13"
                             PasswordChanged="PasswordBox_PasswordChanged" />

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <!-- Login Button -->
                <Button x:Name="LoginBtn" Style="{StaticResource PrimaryButton}"
                        Content="SIGN IN" Height="46" FontSize="14"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsNotLoading}" />

                <!-- Loading Indicator -->
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                             Foreground="{StaticResource TealAccentBrush}"
                             Background="Transparent" BorderThickness="0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="Default: admin@maueyecare.com / Admin@12345"
                           HorizontalAlignment="Center" FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,20,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
